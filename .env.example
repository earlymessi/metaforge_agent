# 复制为 .env 并填入真实密钥（.env 已在 .gitignore，勿提交）
LLM_ENABLED=1
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-air
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_TIMEOUT_SEC=60
LLM_FALLBACK=rule
# 意图路由：glm/auto=智谱 GLM 优先；rule=仅极简关键词回退（离线）
LLM_ROUTER=glm
LLM_PLAN_ENABLED=1
LLM_PLAN_AGENTS=scheduling,events,kitting,commitment,whatif
# 操作审计（写应用日志；AUDIT_LOG_MONGO=1 可写 Mongo audit_log 集合）
AUDIT_LOG_ENABLED=1
# ReAct 逐步选 Tool（默认关；与 LLM_PLAN 二选一试用）
LLM_REACT_ENABLED=0
LLM_REACT_AGENTS=scheduling,events
LLM_REACT_MAX_STEPS=8
# Tool 失败反思（ReAct 模式下生效；默认关）
LLM_REFLECT_ENABLED=0
LLM_REFLECT_MAX_RETRIES=2
# Tool 完成后 LLM 组织面向用户的 summary（默认开，LLM 失败回退 artifacts）
LLM_SUMMARIZE_ENABLED=1

# Session / HITL：mongo 持久化（重启后端后 session 与 confirm_token 仍有效）
SESSION_STORE=mongo
# MCP 外部工具（默认关闭）
MCP_ENABLED=0
# MCP_SERVER_URL=

# 后端唯一端口（前后端统一用 8008，勿再开 8000/8010）
METAFORGE_PORT=8008
METAFORGE_RELOAD=0

# MongoDB（可选，与 tests/main.py 默认一致时可省略）
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=metaforge_mes
